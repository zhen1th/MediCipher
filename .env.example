# Konfigurasi Database MySQL MediCipher
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medicipher_db

# Konfigurasi Aplikasi
APP_ENV=development
APP_SECRET_STORAGE=storage/master.key.enc
SESSION_TIMEOUT_MINUTES=15
USB_CHECK_INTERVAL_SECONDS=3

# Ambang Batas Verifikasi Wajah (Cosine Distance, semakin kecil semakin mirip)
# Nilai default Facenet512 yang direkomendasikan adalah 0.30
FACE_DISTANCE_THRESHOLD=0.30

